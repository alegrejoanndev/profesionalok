# ───────── Base de datos (PostgreSQL) ─────────
# VACÍO = modo demo: el sitio funciona con perfiles de ejemplo, sin instalar nada.
# Para la versión completa (alta, panel, cobros) reemplazá la línea de abajo por:
#   DATABASE_URL="postgresql://pro:pro@localhost:5432/profesionalesok"
# (es la base que enciende "docker compose up -d"; o pegá la URL de una base de neon.tech)
DATABASE_URL=""

# ───────── Sitio ─────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ───────── Panel interno (/admin) ─────────
# Sin ADMIN_PASSWORD el panel queda deshabilitado. Elegí una contraseña larga.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# ───────── Mercado Pago ─────────
# "mock"  = simulador local, NO necesita cuenta (para probar el flujo completo).
# "live"  = Mercado Pago real (usá credenciales de prueba primero).
MP_MODE="mock"
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
# Precio mensual de la suscripción en pesos argentinos (solo el número)
MEMBERSHIP_PRICE_ARS="15000"
# Meses de prueba gratis en la primera suscripción de cada profesional (0 = sin prueba)
TRIAL_MONTHS="1"

# Link de suscripción de Mercado Pago. Por defecto se usa https://mpago.la/1TeHYiV (SITE.paymentLink en
# lib/site.ts): el mes gratis y el precio los define el PLAN de ese link, y el pago se asocia al
# profesional por el email. Para usar OTRO link, descomentá y cambialo. Para que el sitio cree un
# checkout por profesional con la API (necesita MP_ACCESS_TOKEN), dejalo vacío: MP_SUBSCRIPTION_LINK=""
# MP_SUBSCRIPTION_LINK="https://mpago.la/1TeHYiV"
# MP_LINK_HAS_TRIAL="true"   # ponelo en "false" si el plan del link NO tiene prueba gratis

# ───────── Validación automática de matrículas (REFEPS, Ministerio de Salud) ─────────
# "off"    = sin validación automática: todo pasa a revisión manual en /admin.
# "mock"   = simulador para desarrollo (matrícula que empieza con 9 = verificada, con 0 = no habilitada).
#            Está bloqueado en producción: nunca aprueba matrículas falsas en un sitio publicado.
# "refeps" = registro oficial. Requiere SISA_USER y SISA_PASSWORD (hay que pedirlos al SISA).
MATRICULA_MODE="mock"
SISA_USER=""
SISA_PASSWORD=""
# Cuándo se aprueba un perfil sin intervención humana:
#   "dni"    = solo si el DNI informado coincide con el registro (recomendado)
#   "always" = también si coinciden solo el nombre y la matrícula (menos seguro: son datos públicos)
#   "never"  = nunca; siempre revisa una persona
MATRICULA_AUTO_APPROVE="dni"
# Clave para el chequeo periódico de matrículas: GET /api/cron/revalidar (ver README)
CRON_SECRET=""

# ───────── Emails ─────────
# Sin RESEND_API_KEY, los mails se guardan como archivos HTML en la carpeta .emails/
RESEND_API_KEY=""
EMAIL_FROM="profesionalesok <no-responder@profesionalesok.com.ar>"
# Dónde llegan los mensajes del formulario de contacto
CONTACT_TO="Profesionaleshoy.rqta@gmail.com"
